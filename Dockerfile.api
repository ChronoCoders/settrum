# Multi-stage build for Settrum API

# Stage 1: Builder
FROM rust:1.75-slim as builder

# Install dependencies
RUN apt-get update && \
    apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /settrum

# Copy workspace configuration
COPY Cargo.toml Cargo.lock ./

# Copy API source
COPY settrum-api ./settrum-api

# Build API in release mode
RUN cargo build --release -p settrum-api

# Stage 2: Runtime
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y \
    ca-certificates \
    libssl3 \
    libpq5 && \
    rm -rf /var/lib/apt/lists/*

# Create settrum user
RUN useradd -m -u 1000 -U -s /bin/sh settrum

# Copy binary from builder
COPY --from=builder /settrum/target/release/settrum-api /usr/local/bin/

# Copy migrations
COPY settrum-api/migrations /migrations

# Set ownership
RUN chown -R settrum:settrum /usr/local/bin/settrum-api /migrations

# Switch to settrum user
USER settrum

# Expose API port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/settrum-api", "--health-check"] || exit 1

# Default command
ENTRYPOINT ["/usr/local/bin/settrum-api"]
